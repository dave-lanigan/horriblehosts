# Set the same variable names in Vercel, then redeploy.
# Both Clerk keys must be present during the build to enable authentication.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Use libsql://your-database.turso.io in production.
# For local storage, file:./.data/horriblehosts.db works without a token.
NUXT_TURSO_DATABASE_URL=
NUXT_TURSO_AUTH_TOKEN=

# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable; it pseudonymizes author IDs and enforces posting quotas.
NUXT_POST_AUTHOR_SECRET=
